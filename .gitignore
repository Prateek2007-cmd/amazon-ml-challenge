__pycache__/
*.pyc
.DS_Store
.venv/
venv/

# Real challenge data — large, provided externally, not for git history.
# dataset/sample/ is the small committed fixture and is NOT covered by this.
dataset/train/*.tsv
dataset/test/*.tsv
!dataset/train/.gitkeep
!dataset/test/.gitkeep

# Generated outputs — regenerated by pipeline.py, not tracked in git.
# Still gets included manually in the final submission zip.
output/*.tsv
*.db
*.sqlite

